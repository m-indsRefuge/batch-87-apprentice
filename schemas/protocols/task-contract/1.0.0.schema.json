{
  "$id": "https://batch87.local/schemas/protocols/task-contract/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_sources": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "authority_grant": {
      "items": {
        "enum": [
          "observe",
          "analyse",
          "propose",
          "execute"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "claimed_authority_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "effective_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "type": "string"
    },
    "expected_output_schema_id": {
      "minLength": 1,
      "type": "string"
    },
    "governing_constraints": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "objective": {
      "minLength": 1,
      "type": "string"
    },
    "prohibited_actions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "project_scope_id": {
      "format": "uuid",
      "type": "string"
    },
    "provenance": {
      "minProperties": 1,
      "type": "object"
    },
    "requested_operation": {
      "additionalProperties": false,
      "properties": {
        "action_class": {
          "enum": [
            "observe",
            "analyse",
            "propose",
            "execute",
            "ambiguous"
          ]
        },
        "autonomous": {
          "type": "boolean"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "action_class",
        "autonomous"
      ],
      "type": "object"
    },
    "requested_scope_id": {
      "format": "uuid",
      "type": "string"
    },
    "requesting_principal": {
      "enum": [
        "apprentice",
        "operator",
        "codex_development_harness",
        "experimental_harness"
      ]
    },
    "required_evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    },
    "stop_conditions": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "task_id": {
      "format": "uuid",
      "type": "string"
    },
    "task_type": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "task_id",
    "session_id",
    "project_scope_id",
    "requested_scope_id",
    "objective",
    "task_type",
    "requested_operation",
    "requesting_principal",
    "authority_grant",
    "claimed_authority_ids",
    "effective_at",
    "governing_constraints",
    "required_evidence_ids",
    "allowed_sources",
    "prohibited_actions",
    "expected_output_schema_id",
    "stop_conditions",
    "provenance"
  ],
  "title": "B87-I2 Task Contract 1.0.0",
  "type": "object"
}
